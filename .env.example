# Copy to .env and fill in locally. Never commit .env.
# Settings are loaded and validated starting from Phase 1 (app/config).
# Non-secret parameters (symbol, grid, risk limits) belong in configs/*.yaml, not here.

# backtest | paper | testnet | live
TRADING_MODE=
# Must be explicitly set to true for live trading (preflight checks are also required).
LIVE_TRADING_ENABLED=

# Bybit API key of a dedicated sub-account: trading permission only,
# withdrawal permission DISABLED, IP whitelist enabled if available.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional: notifications are never required for the trading engine to run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SQLite for development, PostgreSQL for production.
DATABASE_URL=
