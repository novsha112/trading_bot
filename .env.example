# Copy to .env and fill in locally. Never commit .env.
# Read by app/config/settings.py (EnvSettings). Variable names are case-sensitive.
# Unknown keys in a .env file are rejected, so variables for later phases stay commented out.
# Non-secret parameters (symbol, grid, risk limits) belong in configs/*.yaml, not here.

# Required. Exactly one of: backtest | paper | testnet | live
TRADING_MODE=
# Required. Name of the YAML profile in configs/ (e.g. development, paper, testnet).
CONFIG_PROFILE=

# DEBUG | INFO | WARNING | ERROR | CRITICAL (default INFO)
LOG_LEVEL=INFO
# json | console (default json)
LOG_FORMAT=json

# Exactly "true" or "false"; empty means false. true is only allowed with TRADING_MODE=live,
# and live additionally requires it (plus preflight checks in later phases).
LIVE_TRADING_ENABLED=false

# Required for testnet and live; must be set together (or not at all).
# Dedicated sub-account key: trading permission only, withdrawal permission DISABLED,
# IP whitelist enabled if available. Uncomment only when needed: empty values are rejected.
# BYBIT_API_KEY=
# BYBIT_API_SECRET=

# Later phases (not read yet):
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# DATABASE_URL=
